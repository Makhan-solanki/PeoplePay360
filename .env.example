# ============================================
# Hackathon 2026 — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- Database ----
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://hackathon:hackathon_secret@localhost:5432/hackathon_db?schema=public

# ---- Server ----
# Port the backend Express server listens on
PORT=3001
# Node environment: development | production | test
NODE_ENV=development

# ---- JWT ----
# Secret for signing access tokens (min 32 chars, generate with: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_64_char_hex_string_in_production
# Secret for signing refresh tokens (different from access token secret)
JWT_REFRESH_SECRET=change_me_to_a_different_random_hex_string
# Access token expiry (e.g., 15m, 1h)
JWT_ACCESS_EXPIRY=15m
# Refresh token expiry (e.g., 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ---- Rate Limiting ----
# Max requests per window for auth endpoints
RATE_LIMIT_MAX=20
# Window size in minutes
RATE_LIMIT_WINDOW_MINUTES=15

# ---- AWS S3 (for file uploads) ----
# Leave blank if not using S3 — the upload module will be disabled
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ---- Frontend (Next.js) ----
# Public URL of the backend API (used in browser requests)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ---- Postgres Docker ----
POSTGRES_USER=hackathon
POSTGRES_PASSWORD=hackathon_secret
POSTGRES_DB=hackathon_db
